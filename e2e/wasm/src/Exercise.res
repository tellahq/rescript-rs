let fitted = Geometry.fitted({width: 400., height: 100.}, Within({size: {width: 100., height: 100.}}), ["a", "b"], "n")
let empty = Geometry.echoShape(Empty({}))
let placed = Geometry.echoShape(Placed({metadata: {content_type: "image/png", visible: false}, sizes: [{width: 3., height: 4.}]}))
let unbounded = Geometry.fitted({width: 3., height: 4.}, Unbounded({}), [], "")
let absent = Geometry.echoOptional(None)
let present = Geometry.echoOptional(Some("value"))
let fallback = Geometry.labelOr(None, "untitled")
let labelled = Geometry.labelOr(Some("named"), "untitled")
let paperback = Geometry.echoFormat(Paperback)
let ebook = Geometry.echoFormat(Ebook)
let noControls = Geometry.echoCurve({name: "ease", controls: None})
let controls = Geometry.echoCurve({name: "custom", controls: Some([0.1, 0.2])})
let noNumber = Geometry.echoNumber(None)
let zero = Geometry.echoNumber(Some(0.))
let noCount = Geometry.echoCount(None)
let zeroCount = Geometry.echoCount(Some(0))
let noFlag = Geometry.echoFlag(None)
let falseFlag = Geometry.echoFlag(Some(false))

let tally = Geometry.Tally.make([{width: 2., height: 3.}], "box")
let added = tally->Geometry.Tally.add({width: 1., height: 1.})
let area = tally->Geometry.Tally.area(2.)
let count = tally->Geometry.Tally.count
let isEmpty = tally->Geometry.Tally.isEmpty
let largest = tally->Geometry.Tally.largest
let scaled = tally->Geometry.Tally.scaled(2.)
let () = tally->Geometry.Tally.free

let readings = Geometry.readings([{width: 0.1, height: 2.}, {width: 3., height: 4.}], 1.)
let positions = Geometry.positions([Paperback], 2)
let notStored = Geometry.findStored(0)
let stored = Geometry.findStored(2)
